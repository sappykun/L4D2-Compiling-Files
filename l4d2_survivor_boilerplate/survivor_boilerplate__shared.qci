$include "l4d2_survivor_boilerplate/macro_animadjustment.qci"

$unlockdefinebones

// Basic HL2 attachments used for face tracking and mouth illumination
// Shouldn't need to change these, the exact position is not important
$attachment "forward" "ValveBiped.Bip01_Head1" 2 -3 0 rotate 0 -76 -90
$attachment "eyes" "ValveBiped.Bip01_Head1" 3.5 -2.5 0.0 rotate 0 -90 -90
$attachment "mouth" "ValveBiped.Bip01_Head1" 0.5 -5.0 0.0 rotate 0 -80 -90

// Used for moving the bandage trails when healing
// Each character uses two attachment points
$attachment "armL" "ValveBiped.Bip01_L_Forearm" 0 0 0 rotate 0 0 0
$attachment "legL" "ValveBiped.Bip01_L_Calf" 0 0 0 rotate 0 0 0
$attachment "legR" "ValveBiped.Bip01_R_Thigh" 0 0 0 rotate 0 0 0

// Used for the Smoker's tongue when he ensnares you
// Changing the values does nothing, but the attachment must exist for the tongue model to show up
$attachment "spine" "ValveBiped.Bip01_Spine" 0 0 0 rotate -90 -90 0

