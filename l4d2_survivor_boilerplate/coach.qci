
$definevariable declareSequenceFile declaresequence.qci

$include "l4d2_survivor_boilerplate/coach/bone.qci"

$sequence "coach" $correctiveAnimation$ fps 30.00
$include l4d2_survivor_boilerplate/coach/$declareSequenceFile$

$includemodel "survivors/anim_coach.mdl"
$includemodel "survivors/gestures_coach.mdl"

$animation a_proportions $baseAnimation$ subtract "coach" 0
$sequence proportions a_proportions predelta autoplay

$include "l4d2_survivor_boilerplate/_shared.qci"
