
$definevariable desiredModelScale 1.0
$definevariable smallProportionBaseScale 1.0

$definemacro boilerplateIncludeModels \\
$includemodel "survivors/anim_producer.mdl" \\
$includemodel "survivors/gestures_producer.mdl" \\

$definevariable declareSequenceFile declaresequence.qci

$include "l4d2_survivor_boilerplate/rochelle/bone.qci"

$sequence "producer" $correctiveAnimation$ fps 30.00 scale $smallProportionBaseScale$
$include l4d2_survivor_boilerplate/rochelle/$declareSequenceFile$

$boilerplateIncludeModels

$scale $desiredModelScale$

















$animation a_proportions $baseAnimation$ subtract "producer" 0
$sequence proportions a_proportions predelta autoplay

$include "l4d2_survivor_boilerplate/_shared.qci"