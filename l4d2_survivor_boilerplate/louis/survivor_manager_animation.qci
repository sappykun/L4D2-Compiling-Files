
$sectionframes 30 168

$poseparameter "body_pitch" -90 90 loop 360
$poseparameter "body_yaw" -90 90 loop 360
$poseparameter "head_pitch" -90 90 loop 360
$poseparameter "head_yaw" -90 90 loop 360

$ikchain "rhand" $IK_rhand$ knee 0.707 0.707 0
$ikchain "lhand" $IK_lhand$ knee 0.707 0.707 0
$ikchain "rfoot" $IK_rfoot$ knee 0.707 -0.707 0
$ikchain "lfoot" $IK_lfoot$ knee 0.707 -0.707 0
$ikchain "ikclip" "ValveBiped.weapon_bone_Clip" knee 0.707 -0.707 0

//$ikautoplaylock "rfoot" 1 0.1
//$ikautoplaylock "lfoot" 1 0.1

$sequence "ragdoll" $correctiveAnimation$ ACT_DIERAGDOLL 1 fps 30.00

// Louis uses Francis's animations for everything besides Heal_Self_Standing_06
$include "l4d2_survivor_boilerplate/boilerplate_francis/Francis_$DeclareSequence.qci"

$includemodel "survivors/anim_Biker.mdl"
$includemodel "survivors/gestures_biker.mdl"

$animation a_proportions $baseAnimation$ subtract "Manager" 0
$sequence proportions a_proportions predelta autoplay
