/*
	A template for using this boilerplate setup.
	This template assumes you're replacing Ellis. To replace another survivor,
	just change references of "mechanic" to whatever survivor you want.
*/

// Rest position of your replacement model
$definevariable baseAnimation "anims/mymodelAction.smd"

// Posed position of the survivor you're replacing, posed to match rotations of your model
$definevariable correctiveAnimation "anims/mechanic_model_merged_skeletonAction.smd"

// Name of the model you're replacing
$modelname "survivors/survivor_mechanic.mdl"

// All material dirs this model will reference
$cdmaterials "models/survivors/mymodel/"

// Any $body or $model definitions, including flexes
$body "body" "mymodel.smd"

// See survivor_definebones_template.qc
$include "mymodel_definebones.qci"

// Two important bones. weapon_bone controls the attachment point for weapons held in the right hand
// (guns, single-handed melee weapons, etc), while L_weapon_bone controls two-handed melee weapons.
// The left pistol when using dual pistols unfortunately can't be readjusted.
// This will probably require a lot of tweaking and recompiling.
$definebone "ValveBiped.weapon_bone" "ValveBiped.Bip01_R_Hand" 1.85 -1.6 -0.6 -15.616423 -95.427702 -95.0 0 0 0 0 0 0
$definebone "ValveBiped.L_weapon_bone" "ValveBiped.Bip01_L_Hand" 2.0 -1 0 -4 90 113 0 0 0 0 0 0

// Add the boilerplate for whatever survivor you're replacing here
$include "l4d2_survivor_boilerplate/survivor_boilerplate_ellis.qci"

// IK foot rules exposed here in case you need to adjust them for your model
$ikautoplaylock "rfoot" 1 0.1
$ikautoplaylock "lfoot" 1 0.1

// Attachments for collectables.  You can either use HLMV to tweak these values, or
// use other methods for getting specific coordinates using Blender.
$attachment "pistol" "ValveBiped.Bip01_Pelvis" -7.00 5.00 -6.00 rotate -85 -40 -80
$attachment "primary" "ValveBiped.Bip01_Spine4" 2.92 -4.69 -2.50 rotate -14 170 174
$attachment "melee" "ValveBiped.Bip01_Spine4" 2.61 -5.06 4.98 rotate 44 175 97
$attachment "pills" "ValveBiped.Bip01_Pelvis" -0.00 -2.0 0.00 rotate 80 90 0
$attachment "molotov" "ValveBiped.Bip01_Pelvis" 0 -1.5 0.5 rotate 0 0 -70
$attachment "medkit" "ValveBiped.Bip01_Pelvis" 0.00 -4.00 5.00 rotate -0 -0 -160
// $attachment "cigarette" "ValveBiped.Bip01_Head1" -0.2 -5.1 1.8 rotate 0 -90 -90 // Only for Bill

// Animation adjustments. If an animation doesn't need adjustment, just comment that line out.
$AnimAdjustment Idle_Incap_Pistol 0 0 -1 7 0 0
$AnimAdjustment Idle_Incap_Elites 0 0 -1 7 0 0
$AnimAdjustment Idle_Incap_Pounced 0 0 -1 7 0 0
//$AnimAdjustment incap_crawl 0 0 -1 7 0 0 // Coach doesn't use this
$AnimAdjustment Idle_Incap_Hanging1 0 -1 -2 0 0 0
$AnimAdjustment Idle_Incap_Hanging2 0 -2 -3.75 0 0 0
$AnimAdjustment Idle_Incap_Hanging3 0 -2 -5 0 0 0
$AnimAdjustment Die_Standing 0 0 1.5 4 -2.5 0
$AnimAdjustment Die_Incap 0 0 -1.5 6 -3 0
$AnimAdjustment Defib_jolt 0 0 -1.5 6 -3 0

// Anything else your model might have.
$include "mymodel_jigglebone.qci"
$include "mymodel_collision.qci"
$include "mymodel_box.qci"
$include "mymodel_lod.qci"